{
  // Typecheck-only pass that DOES include the tests.
  //
  // `tsconfig.json` excludes `*.test.ts` so they never reach `lib`, and
  // `bun test` only strips types — so between the two, nothing in this
  // repository ever typechecks a test file. That is normally a tolerable gap,
  // but TASK-022 WP-1 owns a tooth that is PURELY type-level: tech_spec ОВ-5
  // requires that `NarrativeEntity` has no `kind`/`label`/`uri`, "checked with
  // `@ts-expect-error`, not by eye". An unchecked `@ts-expect-error` is an
  // assertion that cannot fail, which is indistinguishable from an absent one —
  // and this pass is what makes it fail. If the removed fields ever come back,
  // the directive becomes unused and `tsc` errors on it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // `rootDir` only constrains emit, and there is none here. Widening it is
    // what lets `test/` — which sits beside `src/`, not under it — into the
    // same program.
    "rootDir": ".",
    // The tests run under `bun`, so the program needs `bun:test` and
    // `import.meta` — neither of which the commonjs product build wants.
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": []
}
